{
  "name": "anagram-game-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript game engine for the progressive anagram game (daily + freeplay, hints, share score). No runtime dependencies — the data pipeline scripts at the repo root are untouched.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node dist/examples/cli-demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
